# Discord bot token — Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# llm.provider: grokbot (default) — no AI key needed
# Webhook URL + sender key from the Grok Bot routine panel (never paste the key in chat)
GUARDIAN_WEBHOOK_URL=
GUARDIAN_WEBHOOK_KEY=
# Shared secret for the 127.0.0.1 command API used by `npm run cmd` (16+ random chars)
GUARDIAN_LOCAL_SECRET=
# GUARDIAN_LOCAL_PORT=8787

# Optional, only for llm.provider: openai (xAI or other OpenAI-compatible) / anthropic
LLM_API_KEY=
ANTHROPIC_API_KEY=
